# Copy to .env and fill in to run as a public website.
# Leave GOOGLE_CLIENT_ID empty to run in local mode on your own machine (no sign-in, no limits).
# Keep comments on their own lines: anything after = is the value.

APP_NAME=Hinglish Captions
# Your public https address
BASE_URL=https://captions.example.com

# Google sign-in: console.cloud.google.com > APIs & Services > Credentials >
# Create OAuth client ID > Web application. Add BASE_URL to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Razorpay: dashboard.razorpay.com > Account & Settings > API Keys (start with Test Mode keys).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhooks: add BASE_URL/billing/webhook with events payment.captured and order.paid.
RAZORPAY_WEBHOOK_SECRET=

# Claude, for Hinglish cleanup: console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# Server
HOST=0.0.0.0
PORT=7860
# Set to 1 when running behind nginx or a load balancer
TRUST_PROXY=1
# Optional; generated into data/secret.key if empty
# SECRET_KEY=
# Users, payments and dictionaries live here: back it up
# DATA_DIR=/app/data
